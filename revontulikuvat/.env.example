# Google Apps Scriptin verkkosovelluksen osoite (Deploy → Web app → URL)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
# Salasana, jonka apps-script/backend.gs:n asenna-funktio tulostaa lokiin
APPS_SCRIPT_SECRET=
# Sivun julkinen osoite QR-kortteja varten (ilman / loppuun), esim. https://kuvat.booklapland.fi
SITE_URL=
# Tietosuojaselosteen osoite, näytetään asiakkaalle (vapaaehtoinen)
NEXT_PUBLIC_PRIVACY_URL=
