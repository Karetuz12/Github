# Google Apps Script web app URL (Deploy → Web app → URL, ends with /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
# Secret printed to the log by the setup function in apps-script/backend.gs
APPS_SCRIPT_SECRET=
# Public address of the site, used in the QR cards (no trailing slash), e.g. https://photos.booklapland.fi
SITE_URL=
# Privacy policy URL shown to customers (optional)
NEXT_PUBLIC_PRIVACY_URL=
